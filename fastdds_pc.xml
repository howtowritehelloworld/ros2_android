<?xml version="1.0" encoding="UTF-8" ?>
<dds xmlns="http://www.eprosima.com/XMLSchemas/fastDDS_Profiles">
    <profiles>
        <transport_descriptors>
            <transport_descriptor>
                <transport_id>udp_wifi</transport_id>
                <type>UDPv4</type>
                <!-- Bind the PC Wi-Fi NIC so Docker bridges do not swallow discovery. -->
                <interfaces>
                    <allowlist>
                        <interface name="wlp0s20f3"/>
                    </allowlist>
                </interfaces>
            </transport_descriptor>
        </transport_descriptors>

        <participant profile_name="rosdroid_pc" is_default_profile="true">
            <rtps>
                <useBuiltinTransports>false</useBuiltinTransports>
                <userTransports>
                    <transport_id>udp_wifi</transport_id>
                </userTransports>
                <builtin>
                    <initialPeersList>
                        <locator>
                            <udpv4>
                                <address>192.168.0.152</address>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>192.168.0.255</address>
                            </udpv4>
                        </locator>
                        <locator>
                            <udpv4>
                                <address>239.255.0.1</address>
                            </udpv4>
                        </locator>
                    </initialPeersList>
                </builtin>
            </rtps>
        </participant>
    </profiles>
</dds>
